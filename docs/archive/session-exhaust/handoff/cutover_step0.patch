@@ -886,8 +886,22 @@ func _grow_vein(world: WorldData, rng: RandomNumberGenerator, seed_cell: Vector2
 			continue
 		var here: StringName = world.blocks.get(cell, &"")
 		if here != &"earth" and here != &"stone" and here != &"deepslate" and here != &"shale":
-			continue                                # only replace SOLID rock (never fill a carved cave)
-		world.blocks[cell] = material
+			continue                                # only seed inside SOLID rock (never fill a carved cave)
+		if world.lodes.has(cell):
+			continue                                # another vein already owns this cell — bodies do not overlap
+		# THE CUTOVER (`docs/LODE_PLAN.md` phase 3). This line used to be `world.blocks[cell] = material`, and
+		# that one assignment was the whole old game: a vein WAS the rock, so the pick could not tell "get me
+		# through here" apart from "give me that", and a tunnel driven through a body destroyed everything it
+		# did not happen to pocket. Now the host rock stays exactly as the strata laid it down and the metal
+		# goes into its own plane behind it. Nothing else in this function changes — the blob walk, the
+		# richness, the min_row floor and the RNG draw order are identical, so a given seed grows the same
+		# SHAPE it always grew, in the same order, and determinism survives the migration.
+		#
+		# The lodes guard above replaces a check that used to happen for free: an already-placed &"ore" cell
+		# failed the host-material test, so bodies could never overlap. With the host left intact that test
+		# stops refusing them, and without this line a later vein would silently overwrite an earlier one's
+		# material while keeping its richness.
+		world.lodes[cell] = material
 		world.amounts[cell] = richness
 		filled[cell] = true
 		placed += 1
