+
+
+## tool / material / machine, the container each item belongs to.
+func _item_category_c(item: StringName) -> String:
+	if machine_icons.has(item):
+		return "machine"
+	if MiningRules.is_tool_item(item):
+		return "tool"
+	return "material"
+
+
+## A tray pocket: rounded corners, the softest silhouette of the three, since a material is the thing you
+## reach for constantly and should feel like it sits loosely in cloth, not bolted down.
+func _draw_material_well_c(rect: Rect2, fill: Color, edge: Color, edge_w: float) -> void:
+	var sb := StyleBoxFlat.new()
+	sb.bg_color = fill
+	sb.border_color = edge
+	sb.set_border_width_all(edge_w)
+	sb.set_corner_radius_all(7)
+	draw_style_box(sb, rect)
+
+
+## A bolted crate pocket: chamfered corners, drawn as two nested octagons (edge colour behind, fill inset
+## on top) since `draw_colored_polygon` has no stroke-width primitive of its own.
+func _draw_machine_well_c(rect: Rect2, fill: Color, edge: Color, edge_w: float) -> void:
+	draw_colored_polygon(_octagon_points_c(rect, 6.0), edge)
+	draw_colored_polygon(_octagon_points_c(rect.grow(-edge_w), maxf(6.0 - edge_w, 1.0)), fill)
+
+
+func _octagon_points_c(rect: Rect2, chamfer: float) -> PackedVector2Array:
+	var l: float = rect.position.x
+	var t: float = rect.position.y
+	var r: float = rect.end.x
+	var b: float = rect.end.y
+	return PackedVector2Array([
+		Vector2(l + chamfer, t), Vector2(r - chamfer, t), Vector2(r, t + chamfer), Vector2(r, b - chamfer),
+		Vector2(r - chamfer, b), Vector2(l + chamfer, b), Vector2(l, b - chamfer), Vector2(l, t + chamfer),
+	])
+
+
+## A rack pocket: a plain well plus a small brass peg notch at the top centre, suggesting it hangs from
+## the rail drawn across the tool container's plate rather than sitting flush in a tray.
+func _draw_tool_well_c(rect: Rect2, fill: Color, edge: Color, edge_w: float) -> void:
+	draw_rect(rect, fill)
+	draw_rect(rect, edge, false, edge_w)
+	var cx: float = rect.get_center().x
+	draw_colored_polygon(PackedVector2Array([
+		Vector2(cx - 3.0, rect.position.y), Vector2(cx + 3.0, rect.position.y), Vector2(cx, rect.position.y + 4.0),
+	]), HOTBAR_TOOL_ACCENT_C)
+
