+const HOTBAR_MATERIAL_WELL_C: Color = Color(0.24, 0.26, 0.22, 0.55)
+const HOTBAR_MACHINE_WELL_C: Color = Color(0.20, 0.23, 0.27, 0.60)
+const HOTBAR_WELL_EMPTY_ALPHA_C: float = 0.30      ## multiplies a well's own alpha for an empty pocket
+const HOTBAR_EDGE_QUIET_C: Color = Color(0.30, 0.34, 0.42, 0.40)
+const HOTBAR_TOOL_ACCENT_C: Color = Color(0.80, 0.66, 0.30, 0.80)
