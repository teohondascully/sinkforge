--- /dev/null
+++ b/tools/eval/player_feed.gd
@@ -0,0 +1,98 @@
+class_name EvalPlayerFeed
+extends RefCounted
+
+## WHAT A PLAYER CAN SEE, AND NOTHING ELSE. This is the object a judged actor is handed for the
+## agent-journey evaluation, and it exists because gate 6 of `docs/AGENT_PLAY_EVALUATION_PROTOCOL.md`
+## is the one gate a prompt cannot satisfy. The protocol says an actor exposed to `FactorySim`, target
+## cells, inventories, resource lists, objective IDs or world-event state makes the evaluation INVALID
+## rather than low-scoring, so the boundary has to be a property of the code.
+##
+## THIS IS NOT `tools/play_agent.gd` AND MUST NOT REPLACE IT. That actor reads the sim fifty times and is
+## right to: it drives the deterministic layers, and reading state is why it is fast enough for a sweep
+## and stable enough to assert against. It is a privileged test driver. This is the blind one.
+##
+## The reachability oracle the protocol describes is also privileged, also legitimate, and also not this.
+## The evidence chain is: the oracle proves a path exists, the capability suite proves the actor can
+## operate the controls, and only then does a blind actor say anything about communication or motivation.
+##
+## HOW THE BOUNDARY IS ACTUALLY HELD, since an object with a narrow API proves little on its own: every
+## `class_name` in this project is a global reachable by bare name from any script in it, so an actor
+## could write `FactorySim` without ever touching this feed. The structural half is here; the other half
+## is `tools/eval/check_actor_boundary.gd`, which reads the actor's SOURCE and rejects those names. Both
+## halves are needed and neither is sufficient. Read that file before trusting this one.
+
+## The rendered frame, which is the actor's only view of the world. A copy: handing back the live texture
+## image would let a caller keep a reference that updates underneath its own decision.
+var _vp: Viewport = null
+## The verb vocabulary a player has, passed in rather than read off `Controls`, so that this file needs no
+## project global of its own and the checker's rule can be uniform instead of carrying an exception.
+var _actions: Array[StringName] = []
+var _audio: bool = false
+## Every input this feed was asked to deliver, in order, for the receipt. The protocol requires the exact
+## input cadence to be retainable, and a feed that cannot say what it sent cannot support that claim.
+var _log: Array[Dictionary] = []
+
+
+func _init(vp: Viewport, actions: Array[StringName], audio: bool) -> void:
+	_vp = vp
+	_actions = actions.duplicate()
+	_audio = audio
+
+
+## The pixels on the screen this instant. The actor's whole world model comes through here.
+func frame() -> Image:
+	if _vp == null:
+		return null
+	var tex: ViewportTexture = _vp.get_texture()
+	return null if tex == null else tex.get_image()
+
+
+func screen_size() -> Vector2i:
+	return Vector2i.ZERO if _vp == null else _vp.get_visible_rect().size
+
+
+func audio_enabled() -> bool:
+	return _audio
+
+
+## The verbs a player has. Names only, the same strings the settings screen shows when remapping.
+func actions() -> Array[StringName]:
+	return _actions.duplicate()
+
+
+## Press or release one of those verbs. An action outside the vocabulary is refused rather than passed
+## through, because a feed that forwards anything asked of it is a feed with no boundary.
+func act(action: StringName, pressed: bool) -> bool:
+	if not _actions.has(action):
+		_log.append({"kind": "refused", "action": action})
+		return false
+	var ev := InputEventAction.new()
+	ev.action = action
+	ev.pressed = pressed
+	Input.parse_input_event(ev)
+	_log.append({"kind": "act", "action": action, "pressed": pressed})
+	return true
+
+
+## Point at a place ON THE SCREEN, in pixels, which is what a hand on a mouse can do. Deliberately not a
+## world cell: a cell is a coordinate the actor would have had to be told, and being told is the thing
+## gate 6 forbids.
+func point_at_screen(px: Vector2) -> void:
+	var ev := InputEventMouseMotion.new()
+	ev.position = px
+	ev.global_position = px
+	Input.parse_input_event(ev)
+	_log.append({"kind": "point", "px": px})
+
+
+func click(button: int, pressed: bool) -> void:
+	var ev := InputEventMouseButton.new()
+	ev.button_index = button
+	ev.pressed = pressed
+	Input.parse_input_event(ev)
+	_log.append({"kind": "click", "button": button, "pressed": pressed})
+
+
+## The input record, for the receipt. Read-only to the actor by being a copy.
+func input_log() -> Array[Dictionary]:
+	return _log.duplicate(true)
