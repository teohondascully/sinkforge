new file mode 100644
index 0000000..83dcc86
--- /dev/null
+++ b/tools/eval/fixtures/clean_actor.gd
@@ -0,0 +1,22 @@
+extends RefCounted
+
+## NEGATIVE CONTROL for `check_actor_boundary`. A blind actor that only ever looks at pixels and presses
+## verbs. It plays badly on purpose; being a good player is not what it is here to demonstrate.
+
+var _feed: EvalPlayerFeed = null
+
+
+func _init(feed: EvalPlayerFeed) -> void:
+	_feed = feed
+
+
+func decide() -> void:
+	var img: Image = _feed.frame()
+	if img == null:
+		return
+	var size: Vector2i = _feed.screen_size()
+	var mid: Color = img.get_pixel(size.x / 2, size.y / 2)
+	var verbs: Array[StringName] = _feed.actions()
+	if mid.get_luminance() < 0.2 and verbs.size() > 0:
+		_feed.act(verbs[0], true)
+	_feed.point_at_screen(Vector2(size) * 0.5)
