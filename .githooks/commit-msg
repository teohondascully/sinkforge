#!/usr/bin/env bash
# Refuse a commit message that names a co-author or a generating tool.
#
# This project has exactly one author. A trailer that says otherwise is wrong regardless of who or what it
# names, so the rule is written about the FORM of the trailer and not about any particular name.
#
# Tracked in .githooks/ rather than .git/hooks/ so it reaches a fresh clone, a worktree, and every checkout
# — .git/hooks is not version-controlled and produces a guard that exists on one machine. Activated by
#     git config core.hooksPath .githooks
# which each clone runs once; tools/check_trailers.sh asserts that setting is present, because a guard that
# does not check its own installation is a file rather than a guard.
#
# This is the ordinary path, not the enforcement: --no-verify skips it. The harness layer is what holds.

msg_file="$1"
PATTERN='^[[:space:]]*(co-authored-by:|[a-z][a-z-]*-session:|generated with \[)'

if grep -qiE "$PATTERN" "$msg_file"; then
	echo "commit-msg: REFUSED — this message carries a co-author or tool-generation trailer." >&2
	echo "  This repository has a single author; see docs/DECISIONS.md." >&2
	echo "  Offending line(s):" >&2
	grep -inE "$PATTERN" "$msg_file" >&2
	echo "  Remove them and commit again. --no-verify does not help: tools/check_trailers.sh scans" >&2
	echo "  every ref inside the suite, so skipping this only defers the failure." >&2
	exit 1
fi

# A change to core/ or sim/ carries a judgment call often enough that "log it" degrades across sessions
# into "forgot to." docs/DECISIONS_LEDGER.md is append-only precisely so a reviewer can trust its
# coverage without re-deriving it from the diff every time — a rule enforced by remembering it is a rule
# enforced by nobody, the same reasoning the trailer check above is built on. If a change genuinely had
# no judgment call in it (a rename, a formatting pass, a comment fix), the override trailer says so
# explicitly rather than the commit silently having none — the override is visible in the log, which is
# the point; a silent gap and a stated one are not the same failure.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^(core|sim)/'; then
	if ! git diff --cached --name-only --diff-filter=ACMR | grep -qx 'docs/DECISIONS_LEDGER.md'; then
		if ! grep -qiE '^[[:space:]]*no-ledger-entry:' "$msg_file"; then
			echo "commit-msg: REFUSED — this commit touches core/ or sim/ with no new" >&2
			echo "  docs/DECISIONS_LEDGER.md entry in the same commit." >&2
			echo "  If this change is a real judgment call, add the ledger entry and commit again." >&2
			echo "  If it genuinely has none (rename, formatting, comment-only), add a trailer:" >&2
			echo "    No-Ledger-Entry: <why this needed no judgment call>" >&2
			exit 1
		fi
	fi
fi
exit 0
