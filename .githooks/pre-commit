#!/bin/sh

# IDENTITY GATE, AND IT RUNS FIRST ON PURPOSE. `commit-msg` refuses co-author and tool-generation
# trailers and does not look at identity at all -- it only ever matched an author line by accident,
# because "Co-Authored-By" contains the word. So there was no identity check anywhere in this repository
# at any stage, and a second author identity reached a branch and sat one merge from main before a
# harness layer noticed.
#
# ORDERING IS LOAD-BEARING. Written at the BOTTOM of this file, this gate was dead twice over: once after
# the final `exit 0`, and then still dead because the mojibake section below opens with
# `[ -z "$files" ] && exit 0`, so a commit staging none of the types it scans returned before reaching it.
# An early return taken for an unrelated reason silently skips every guard after it. Identity does not
# depend on which files are staged, so it is asserted before anything can return.
#
# ASSERTED AGAINST THE LOCAL CONFIG, NOT A LITERAL. Writing the expected address here would make this a
# rule about a string that the next identity walks through, and the string could drift from the config
# with nothing relating them. The real failure is precise: `user.email` is right in THIS repository and
# wrong in the global one, so any checkout resolving to the global config authors as the wrong person.
# Comparing the EFFECTIVE identity to the LOCAL one tests exactly that.
#
# COMMITTER as well as AUTHOR: they diverge independently, and the commit that prompted this had both
# wrong. No message filter would ever have looked at either.
#
# A convenience, not the guard -- `--no-verify` is routine here and skips it. The gate that cannot be
# skipped is `check_trailers` in the harness.
want="$(git config --local user.email 2>/dev/null || true)"
if [ -z "$want" ]; then
	printf 'COMMIT REFUSED: this repository has no local user.email.\n' >&2
	printf 'The identity would come from your global config, which is not the one this\n' >&2
	printf 'history uses. Set it:  git config --local user.email <the address in git log>\n' >&2
	exit 1
fi
ae="$(git var GIT_AUTHOR_IDENT | sed -n 's/^.*<\([^>]*\)>.*$/\1/p')"
ce="$(git var GIT_COMMITTER_IDENT | sed -n 's/^.*<\([^>]*\)>.*$/\1/p')"
if [ "$ae" != "$want" ] || [ "$ce" != "$want" ]; then
	printf 'COMMIT REFUSED: identity does not match this repository.\n' >&2
	printf '  author:    %s\n  committer: %s\n  expected:  %s\n' "$ae" "$ce" "$want" >&2
	printf '\nEvery commit here shares one identity. A checkout that resolved to your GLOBAL\n' >&2
	printf 'config produces this. Fix the checkout rather than amending afterwards.\n' >&2
	exit 1
fi

# BASE-CLASS NAMESPACE GATE, and it sits ABOVE the mojibake block on purpose: that block opens with
# `[ -z "$files" ] && exit 0`, and an early return taken for an unrelated reason silently skips every
# guard after it. The comment at the top of this file says so about the identity gate; this is the same
# rule applied a second time rather than relearned a second time.
#
# It costs nothing (pure text, no engine) and it catches a failure that is invisible where you would look
# for it: a member added to `tools/check_base.gd` breaks a SUBCLASS, so `--check-only` on the file you
# edited is clean, and `godot --script` exits 0 on a load failure so the runner scores the broken layer as
# a PASS. One of those cost a 275-second sweep to find.
#
# Runs on any staged `.gd`, in either direction -- the new member can be in the base or in the layer.
if git diff --cached --name-only --diff-filter=ACM -- '*.gd' | grep -q .; then
	if [ -x tools/check_base_namespace.sh ] || [ -r tools/check_base_namespace.sh ]; then
		if ! sh tools/check_base_namespace.sh >/dev/null 2>/tmp/sf_ns.$$; then
			printf 'COMMIT REFUSED: base-class namespace collision.\n' >&2
			cat /tmp/sf_ns.$$ >&2
			rm -f /tmp/sf_ns.$$
			exit 1
		fi
		rm -f /tmp/sf_ns.$$
	fi
fi

# MOJIBAKE GATE. `perl -0777 -i -pe` and friends treat a file's bytes as Latin-1: feed one a UTF-8
# source with an em dash in it and every `—` comes back as `Ã¢ÂÂ`, silently, while the tool prints
# only "Wide character in print" to stderr. That happened here across five files and 925 characters,
# including live assertion strings that go straight to the harness log, and it was committed twice
# before an adversarial review caught it. ~30% of one commit's diff turned out to be encoding noise.
#
# U+0080..U+009F are C1 control characters. They never appear in legitimate prose or source, and one
# round of the Latin-1/UTF-8 confusion always produces them. Testing for them catches the fault at the
# only moment it is cheap to fix.
files=$(git diff --cached --name-only --diff-filter=ACM -- '*.gd' '*.md' '*.sh' '*.cfg' '*.godot')
[ -z "$files" ] && exit 0
bad=""
for f in $files; do
	[ -f "$f" ] || continue
	# A FILE THAT WILL NOT DECODE IS NOT A FILE WITH NOTHING WRONG. This printed 0 on any exception and 0
	# is the passing value, so the one input most likely to be mojibake -- a file that is no longer valid
	# UTF-8 -- was the input this gate waved through. `-1` is used as the "could not read" signal because
	# the count itself can never be negative, and the branch below refuses on it explicitly rather than
	# letting it fall into the numeric comparison.
	n=$(python3 -c "
import sys
try:
    s = open('$f', encoding='utf-8').read()
except Exception:
    print(-1); sys.exit()
print(sum(1 for c in s if 0x80 <= ord(c) <= 0x9f))
" 2>/dev/null)
	if [ "${n:-x}" = "x" ] || [ "${n:-x}" = "-1" ]; then
		bad="$bad\n  $f (COULD NOT BE READ AS UTF-8 — which is what this gate is looking for)"
	elif [ "$n" -gt 0 ]; then
		bad="$bad\n  $f ($n control characters)"
	fi
done
if [ -n "$bad" ]; then
	printf 'COMMIT REFUSED: mojibake (U+0080-U+009F) in staged files:%b\n' "$bad" >&2
	printf '\nA byte-oriented editor re-encoded UTF-8 as Latin-1. Repair before committing;\n' >&2
	printf 'do not "fix" it by deleting the punctuation.\n' >&2
	exit 1
fi
exit 0
