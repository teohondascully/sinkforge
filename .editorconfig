# Consistent editor defaults across contributors. GDScript uses TABS (the Godot
# convention); the harness/docs use spaces. See https://editorconfig.org.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.gd]
indent_style = tab
indent_size = 4

[*.{md,yml,yaml,json,sh}]
indent_style = space
indent_size = 2
