; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format documentation:
; https://docs.godotengine.org/en/stable/classes/class_projectsettings.html

config_version=5

; Pinned engine version: 4.6.2-stable. Reproducibility — the same version everyone develops
; against. Corrected 2026-08-29 (queue fix R4): this comment previously said CI replaced the
; Godot-installing job with pure static analysis needing no engine at all -- that stopped being
; true once the real `tests` job (godot test suites: determinism, conservation, movement
; acceptance, .github/workflows/harness.yml:199) was added; it downloads and checksum-verifies
; this exact GODOT_VERSION (`env.GODOT_VERSION: "4.6.2-stable"`, matching this pin) before running
; every tests/test_*.gd suite under the real engine. The separate `gates` job (docs/QUALITY.md,
; "structural gates") is the one that runs pure static analysis with no engine -- that part of the
; original claim was correct, just stated as if it were the whole picture. README.md's "Running
; from source" section states the same version so a contributor's local install can't drift from
; either job silently.

[application]

config/name="Sinkforge"
config/description="A factory game with a persistent underground shaft and an idle game's progression curve. The player bores a shaft from a permanent surface rig, builds extraction and routing infrastructure inside it, and hauls refined material back up to satisfy demands waiting at the rig. There is no reset: the shaft is the same shaft, deeper and more built-out than it was an hour ago. (docs/GDD.md §1; corrected 2026-08-29, queue #3 Part M2 -- this string still described the retired run-based roguelite pivot.)"
; No main_scene: the pre-pivot entry point (res://scenes/main.tscn) moved to legacy/scenes/main.tscn,
; which is excluded from the build path on purpose (docs/ARCHITECTURE.md, docs/ONBOARDING.md Task 0.2) —
; pointing this at legacy content would contradict that exclusion. There is no new entry point yet;
; view/ and shell/ are empty skeletons until docs/ONBOARDING.md stage 11. Set this once shell/ exists.
; The old game remains runnable by checking out the `pre-pivot` git tag.
config/features=PackedStringArray("4.6", "Forward Plus")

[display]

; Base render resolution for 2D pixel art. Bumped 640x360 -> 1280x720 (SCALE / Noita-feel spike):
; 2x the render-target pixel density so the world stays crisp when the camera is zoomed WAY out to
; show a big granular world around a small nimble avatar. The HUD authors at Hud.CANVAS (640x360); its
; CanvasLayer is scaled 2x in main.gd so it still fills this doubled viewport (world-space is unaffected —
; the camera applies its own zoom over the render target).
window/size/viewport_width=1280
window/size/viewport_height=720
; Open the window at an integer 1.5x of the base (1920x1080) so pixels stay crisp.
window/size/window_width_override=1920
window/size/window_height_override=1080
; canvas_items + keep = the 2D canvas scales as a whole, letterboxing to preserve aspect.
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

; Nearest-neighbour filtering: no blurring of pixel-art textures. 0 == Nearest.
textures/canvas_textures/default_texture_filter=0

[debug]

; Enforcement tripwire #1 (see DECISIONS.md): make the "static typing everywhere"
; rule self-enforcing. The editor refuses to run code with an untyped declaration.
; Warning level values: 0 = ignore, 1 = warn, 2 = error.
gdscript/warnings/enable=true
gdscript/warnings/untyped_declaration=2

