# audit kept as supporting material rather than as published documentation.
/.rc-prose-*.patch
docs/REPO_PORTFOLIO_AUDIT.md
docs/PRIORITY.md
docs/FEEL_GAP.md
docs/MENU_MATRIX.md
docs/VISUAL_RECOMMENDATIONS_SURFACE.md

# Godot import sidecars for the capture set. The captures now live under docs/media/,
# which carries a .gdignore, so the engine no longer imports them and the sidecars
# describe nothing. Regenerated automatically if a capture is ever moved back.
/_moment_*.png.import
/_crop_*.png.import
