# Godot 4
.godot/
.import/
export.cfg
export_presets.cfg
*.translation

# macOS
.DS_Store

# Builds
build/
*.dmg
*.zip
*.exe
*.pck

# IDE
.vscode/
.idea/

# Local agent state (Assistant Code scheduler locks, etc.)
.assistant/

# Dev harness — generated screenshots (+ their Godot import sidecars)
/_capture*.png
/_capture*.png.import
_zoom_*.png
# "Sees" tier canonical-moment captures (tools/sees.sh) + boot diagnostics — regenerable, never commit
/_moment_*.png
/_moment_*.png.import
/_boot*.png

# Tool-script UIDs — tools/ scripts run by path (never referenced via uid://), so
# their UIDs are noise. Game-script UIDs (scenes/ src/ tests/) ARE committed.
tools/*.uid

# Local visual progress archive — keep on disk, NEVER publish or delete
history/

# Godot's per-machine ProjectSettings override + any local cert bundle it points at. Machine
# state, never project state: nothing here may change how the game builds for anyone else.
override.cfg
.local_ca_stub.pem

# Generated by tools/bake_miner.gd for eyeballing the frame set — not a shipped asset.
_miner_sheet.png
_miner_sheet.png.import
